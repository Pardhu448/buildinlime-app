{
  "name": "buildinlime",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "imports": {
    "#/*": "./src/presentation/*"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "kill -9 $(ss -tlnp | grep -E ':3000|:5173|:8080' | grep -oP 'pid=\\K[0-9]+' | sort -u) 2>/dev/null; true",
    "dev": "vite dev --port 3000 --host",
    "debug": "vite inspect",
    "build": "vite build && node scripts/generate-sw.mjs && node scripts/generate-api-routes.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:up": "docker compose -f docker-compose.e2e.yaml -p buildinlime-e2e up -d --wait",
    "e2e:down": "docker compose -f docker-compose.e2e.yaml -p buildinlime-e2e down -v",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint --fix",
    "backend:up": "docker compose up -d",
    "backend:down": "docker compose down",
    "backend:clear": "docker compose down -v",
    "migrate": "drizzle-kit migrate",
    "migrate:generate": "drizzle-kit generate",
    "psql": "dotenvx run -- sh -c 'psql \"$DATABASE_URL\"'",
    "purge:resources": "dotenvx run -- tsx scripts/purge-resources.ts",
    "migrate:storage": "dotenvx run -- tsx scripts/migrate-storage-to-gcs.ts"
  },
  "dependencies": {
    "@buildinlime/contracts": "workspace:*",
    "@buildinlime/domain-types": "workspace:*",
    "@buildinlime/sync-core": "workspace:*",
    "@dotenvx/dotenvx": "^1.51.2",
    "@electric-sql/client": "1.5.15",
    "@faker-js/faker": "^10.0.0",
    "@google-cloud/storage": "^7.21.0",
    "@journeyapps/wa-sqlite": "1.5.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/browser-db-sqlite-persistence": "0.1.9",
    "@tanstack/electric-db-collection": "0.3.3",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/offline-transactions": "1.0.30",
    "@tanstack/react-db": "0.1.83",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-form": "^1.0.0",
    "@tanstack/react-query": "^5.66.5",
    "@tanstack/react-query-devtools": "^5.84.2",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/router-plugin": "^1.132.0",
    "@trpc/client": "^11.7.2",
    "@trpc/server": "^11.7.2",
    "better-auth": "^1.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.41.0",
    "drizzle-zod": "^0.7.1",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.561.0",
    "nitro": "3.0.1-alpha.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "resend": "^6.9.2",
    "srvx": "^0.11.12",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tanstack/devtools-vite": "^0.3.11",
    "@tanstack/eslint-config": "^0.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.4",
    "jsdom": "^27.0.0",
    "prettier": "^3.5.3",
    "sst": "3.13.2",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5",
    "workbox-build": "^7.4.1"
  }
}
